---
const skills = [
    {
        category: "Languages",
        items: ["Swift", "TypeScript", "JavaScript"],
    },
    {
        category: "Frameworks",
        items: ["SwiftUI", "Astro", "React"],
    },
    {
        category: "Tools",
        items: ["Firebase", "Git", "Vercel"],
    },
];
---

<section class="mx-auto max-w-6xl px-6 py-24">
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl">
        Skills & Technologies
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
            skills.map((skill) => (
                <div class="rounded-xl border border-slate-200 p-6">
                    <h3 class="text-lg font-semibold">{skill.category}</h3>

                    <div class="mt-4 flex flex-wrap gap-2">
                        {skill.items.map((item) => (
                            <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">
                                {item}
                            </span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</section>
