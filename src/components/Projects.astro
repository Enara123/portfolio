const filters = [
    { label: "All", value: "all" },
    { label: "UI/UX", value: "ui/ux" },
    { label: "Software", value: "software" },
    { label: "Mobile", value: "mobile" },
    { label: "Work", value: "work" },
    { label: "Uni", value: "uni" },
