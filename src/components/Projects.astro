---
import ProjectCard from "./ProjectCard.astro";

const filters = [
    { label: "All", value: "all" },
    { label: "UI/UX", value: "ui/ux" },
    { label: "Software", value: "software" },
    { label: "Mobile", value: "mobile" },
    { label: "Work", value: "work" },
    { label: "Uni", value: "uni" },
];

const projects = [
    {
        number: "01",
        title: "Focaii",
        description:
            "A productivity application designed to help students improve focus and manage goals.",
        type: "Mobile · Software",
        categories: ["mobile", "software", "uni"],
        technologies: ["Swift", "SwiftUI", "Firebase", "Core Data"],
        github: "#",
    },
    {
        number: "02",
        title: "Portfolio",
        description:
            "A personal portfolio built with Astro and modern web technologies.",
        type: "Web · Software",
        categories: ["software", "personal"],
        technologies: ["Astro", "Tailwind CSS", "TypeScript"],
        github: "#",
    },
    {
        number: "03",
        title: "UI/UX Project",
        description:
            "A user interface and experience design project focused on creating a simple and intuitive experience.",
        type: "UI/UX",
        categories: ["ui/ux", "uni"],
        technologies: ["Figma"],
        github: "#",
    },
    {
        number: "04",
        title: "Full Stack Project",
        description:
            "A full-stack application built to explore frontend, backend, and data management.",
        type: "Full Stack",
        categories: ["software", "uni"],
        technologies: ["React", "Node.js", "PostgreSQL"],
        github: "#",
    },
];
---

<section id="projects" class="mx-auto max-w-6xl px-6 py-28">
    <!-- Section heading -->
    <div class="max-w-3xl">
        <div class="mb-5 flex items-center gap-3">
            <span
                class="h-2 w-2 rounded-full"
                style="background-color: var(--accent);"></span>

            <span
                class="text-sm font-semibold tracking-wide"
                style="color: var(--accent);"
            >
                SELECTED WORK
            </span>
        </div>

        <h2
            class="text-4xl font-semibold tracking-tight md:text-5xl"
            style="font-family: 'Geist', sans-serif;"
        >
            Things I've built.
        </h2>

        <p
            class="mt-5 max-w-2xl text-lg leading-relaxed"
            style="color: var(--muted);"
        >
            A selection of things I've designed, built, and explored.
        </p>
    </div>

    <!-- Filters -->
    <div
        class="mt-10 flex flex-wrap gap-2"
        role="group"
        aria-label="Filter projects"
    >
        {
            filters.map((filter, index) => (
                <button
                    type="button"
                    data-filter={filter.value}
                    aria-pressed={index === 0}
                    class="rounded-full border px-4 py-2 text-sm font-medium transition-all duration-200"
                    style={
                        index === 0
                            ? "border-color: var(--foreground); background-color: var(--foreground); color: var(--background);"
                            : "border-color: var(--border); color: var(--foreground);"
                    }
                >
                    {filter.label}
                </button>
            ))
        }
    </div>

    <!-- Project grid -->
    <div id="project-grid" class="mt-10 grid gap-6 md:grid-cols-2">
        {projects.map((project) => <ProjectCard {...project} />)}
    </div>
</section>

<script>
    const filterButtons =
        document.querySelectorAll<HTMLButtonElement>("[data-filter]");

    const projectCards =
        document.querySelectorAll<HTMLElement>("[data-categories]");

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const filter = button.dataset.filter ?? "all";

            // Update active filter
            filterButtons.forEach((btn) => {
                const isActive = btn === button;

                btn.setAttribute("aria-pressed", String(isActive));

                btn.style.backgroundColor = isActive
                    ? "var(--foreground)"
                    : "transparent";

                btn.style.color = isActive
                    ? "var(--background)"
                    : "var(--foreground)";

                btn.style.borderColor = isActive
                    ? "var(--foreground)"
                    : "var(--border)";
            });

            // Filter projects
            projectCards.forEach((card) => {
                const categories = card.dataset.categories?.split(",") ?? [];

                const shouldShow =
                    filter === "all" || categories.includes(filter);

                if (shouldShow) {
                    card.classList.remove("hidden");
                } else {
                    card.classList.add("hidden");
                }
            });
        });
    });
</script>
