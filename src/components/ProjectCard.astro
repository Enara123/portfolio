---
interface Props {
    number: string;
    title: string;
    description: string;
    type: string;
    categories: string[];
    technologies: string[];
    github?: string;
    demo?: string;
}

const {
    number,
    title,
    description,
    type,
    categories,
    technologies,
    github,
    demo,
} = Astro.props;
---

<article
    data-categories={categories.join(",")}
    class="group relative overflow-hidden rounded-2xl border p-7 transition-all duration-300 hover:-translate-y-1"
    style="
        border-color: var(--border);
        background-color: var(--background);
    "
>
    <!-- Subtle hover glow -->
    <div
        class="pointer-events-none absolute -right-20 -top-20 h-40 w-40 rounded-full opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-15"
        style="background-color: var(--accent);"
    >
    </div>

    <div class="relative">
        <!-- Number + Type -->
        <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-medium" style="color: var(--accent);">
                {number}
            </span>

            <span class="text-right text-sm" style="color: var(--muted);">
                {type}
            </span>
        </div>

        <!-- Title -->
        <h3
            class="mt-10 text-2xl font-semibold tracking-tight md:text-3xl"
            style="font-family: 'Geist', sans-serif;"
        >
            {title}
        </h3>

        <!-- Description -->
        <p class="mt-4 max-w-xl leading-relaxed" style="color: var(--muted);">
            {description}
        </p>

        <!-- Technologies -->
        <div class="mt-7 flex flex-wrap gap-2">
            {
                technologies.map((tech) => (
                    <span
                        class="rounded-full border px-3 py-1.5 text-sm"
                        style="
                            border-color: var(--border);
                            color: var(--muted);
                        "
                    >
                        {tech}
                    </span>
                ))
            }
        </div>

        <!-- Links -->
        {
            (github || demo) && (
                <div class="mt-8 flex flex-wrap gap-5">
                    {github && (
                        <a
                            href={github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-semibold transition-colors hover:text-[var(--accent)]"
                            style="color: var(--foreground);"
                        >
                            GitHub
                            <span class="ml-1 inline-block transition-transform duration-200 group-hover:translate-x-1">
                                →
                            </span>
                        </a>
                    )}

                    {demo && (
                        <a
                            href={demo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-semibold transition-colors hover:text-[var(--accent)]"
                            style="color: var(--foreground);"
                        >
                            Live Demo
                            <span class="ml-1 inline-block">→</span>
                        </a>
                    )}
                </div>
            )
        }
    </div>
</article>
