---
interface Props {
    title: string;
    description: string;
    type: string;
    technologies: string[];
    github?: string;
    demo?: string;
}

const { title, description, type, technologies, github, demo } = Astro.props;
---

<div
    class="rounded-xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:shadow-lg"
>
    <h3 class="text-xl font-semibold">
        {title}
    </h3>

    <p class="mt-1 text-sm font-medium text-slate-500">
        {type}
    </p>

    <p class="mt-3 text-slate-600">
        {description}
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
        {
            technologies.map((tech) => (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">
                    {tech}
                </span>
            ))
        }
    </div>

    <div class="mt-6 flex gap-4">
        {
            github && (
                <a
                    href={github}
                    class="text-sm font-medium hover:text-blue-600"
                >
                    GitHub →
                </a>
            )
        }

        {
            demo && (
                <a href={demo} class="text-sm font-medium hover:text-blue-600">
                    Live Demo →
                </a>
            )
        }
    </div>
</div>
