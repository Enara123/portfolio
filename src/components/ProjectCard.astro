---
interface Props {
    title: string;
    description: string;
    type: string;
    technologies: string[];
    github?: string;
    demo?: string;
}

const { title, description, type, technologies, github, demo } = Astro.props;
---

<article
    class="group rounded-xl border p-6 transition-all duration-200 hover:-translate-y-1"
    style="
        border-color: var(--border);
        background-color: var(--background);
    "
>
    <div class="flex items-start justify-between gap-4">
        <h3
            class="text-2xl font-semibold tracking-tight"
            style="font-family: 'Geist', sans-serif;"
        >
            {title}
        </h3>

        <span class="shrink-0 text-sm font-medium" style="color: var(--muted);">
            {type}
        </span>
    </div>

    <p
        class="mt-4 max-w-xl text-base leading-relaxed"
        style="color: var(--muted);"
    >
        {description}
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
        {
            technologies.map((tech) => (
                <span
                    class="rounded-full border px-3 py-1 text-sm"
                    style="
                        border-color: var(--border);
                        color: var(--muted);
                    "
                >
                    {tech}
                </span>
            ))
        }
    </div>

    {
        (github || demo) && (
            <div class="mt-8 flex gap-5">
                {github && (
                    <a
                        href={github}
                        class="text-sm font-medium transition-colors"
                        style="color: var(--foreground);"
                        onmouseover="this.style.color='var(--accent)'"
                        onmouseout="this.style.color='var(--foreground)'"
                    >
                        GitHub →
                    </a>
                )}

                {demo && (
                    <a
                        href={demo}
                        class="text-sm font-medium transition-colors"
                        style="color: var(--foreground);"
                        onmouseover="this.style.color='var(--accent)'"
                        onmouseout="this.style.color='var(--foreground)'"
                    >
                        Live Demo →
                    </a>
                )}
            </div>
        )
    }
</article>
